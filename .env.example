# Retell AI Configuration
# Get API key from: https://retellai.com/settings/api-keys
# Get Agent ID from: https://retellai.com/agents (after creating an agent)
# Get Phone Number from: https://retellai.com/dashboard (Phone Numbers section)
NEXT_PUBLIC_RETELL_API_KEY=your_retell_api_key_here
NEXT_PUBLIC_RETELL_AGENT_ID=your_retell_agent_id_here
NEXT_PUBLIC_RETELL_FROM_NUMBER=+1XXXXXXXXXX

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
